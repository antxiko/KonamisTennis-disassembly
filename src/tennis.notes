
# --- la proteccion anticopia ---
# 0x7A31 es la unica instruccion de toda la ROM que escribe en la pagina del
# cartucho, y lo que escribe es un cero en 0x409A, que es el `ret` con el que
# acaba el manejador de interrupcion. En un cartucho no pasa nada: la ROM no se
# deja escribir. Pero en una copia cargada en RAM ese `ret` se vuelve un `nop`,
# la interrupcion sigue de largo y cae en 0x409B, que es INIT: el juego se
# reinicia en cada cuadro. Y salta tarde, al ganar un juego, con lo que la
# copia parece buena un buen rato. Es la misma idea del RC-701, que alli va con
# un ldir sobre el despachador; en este cartucho esta sin parchear.
C 0x7a30 el cero que se va a escribir
7F los COLORES en
# 0x0000, o sea al reves de la colocacion habitual. Nombres en 0x3800, patrones
# de sprite en 0x1800 y atributos de sprite en 0x3B00.

# --- la cabecera del cartucho ---
D 0x4000 0x4010 cabecera_del_cartucho  AB, y la direccion de INIT; el resto a cero
F 0x4000 w

# --- tablas pequenas ---
D 0x430f 0x431f tabla_de_bits  Un valor por cada combinacion de cuatro bits, para 0x4306
F 0x430f 16
D 0x43d0 0x43db cursor_del_menu  Los tiles de la flecha, de dos en dos, hasta el 0xFF
F 0x43d0 11

# --- los ocho registros del VDP ---
D 0x45c9 0x45d1 registros_del_vdp  Los ocho que carga 0x411D: SCREEN 2, patrones en 0x2000 y colores en 0x0000
F 0x45c9 8

# --- las listas de tiles de la portada ---
# Formato de 0x43EA: [direccion de VRAM, 2 bytes] y luego bytes al puerto,
# con 0xFE [n] [b] para repetir y 0xFF para cerrar; dos 0xFF seguidos cierran
# la lista. Las cuatro primeras las encadena 0x43DB con `ld b,004h`.
# El alfabeto va en los tiles: A=0xD1 y de ahi seguido, pero SIN Q ni X, que no
# se usan; los digitos en 0xF0+cifra, el espacio en 0x00 y la (c) en 0xEA.
D 0x45d1 0x4611 pantalla_titulo  Konami's Tennis y (c)KONAMI 1984
D 0x4611 0x462a rotulo_play_select  PLAY SELECT y la opcion 1PLAYER
D 0x462a 0x4636 rotulo_2players  La opcion 2PLAYERS
D 0x4636 0x4641 rotulo_doubles  La opcion DOUBLES
D 0x4641 0x4650 rotulo_game_select  GAME SELECT, para el segundo menu
D 0x4650 0x4662 rotulo_game_select_1  GAME SELECT con el 1
D 0x4662 0x4674 rotulo_game_select_2  GAME SELECT con el 2
D 0x4674 0x4686 rotulo_game_select_3  GAME SELECT con el 3

# --- los guiones de pantalla ---
# Formato de 0x445F: [cuantos bloques] y por bloque un comando:
#   0  bytes crudos, con 0x11 [n] [b] de repeticion
#   1  patrones por indice en la tabla de 0x489D, ocho bytes cada uno
#   3  una direccion y luego pares [n] [b] de relleno
#   *  una direccion, cuantas veces, y el puntero al patron de ocho bytes
# Todo contador a 0 vale 256: el Z80 decrementa antes de comprobar.
D 0x4686 0x489d guion_de_la_portada  Lo ejecuta INIT en 0x4137: patrones y colores del rotulo
D 0x489d 0x49b5 tabla_de_patrones  35 patrones de ocho bytes, que el comando 1 pide por indice
F 0x489d 8
D 0x49b5 0x4ff1 guion_de_la_pista  Un solo guion, que 0x423E ejecuta para montar la pista

# --- la pelota ---

# --- las cuatro fichas de jugador ---
# 0x57BE reparte estos 164 bytes en cuatro copias de 41, en 0xE100, 0xE130,
# 0xE160 y 0xE190: son los cuatro jugadores del modo de dobles. Los bytes 0x10
# a 0x23 de cada ficha son los veinte de atributos de sprite -y, x, patron y
# color, por cada uno de los cinco- que 0x5920 vuelca al VDP.

L 0x4010 interrupcion  Un cuadro entero del juego; lo engancha INIT en H.KEYI
L 0x409b init  Engancha la interrupcion, limpia la RAM y arranca el cartucho
L 0x4161 espera_del_titulo  Deja el rotulo puesto y va borrando la pantalla por filas
L 0x41aa menu_de_jugadores  El PLAY SELECT: uno, dos o dobles
L 0x41f6 menu_de_partido  El GAME SELECT: a cuantos juegos se juega
L 0x4234 monta_la_pista  Deja la pantalla del partido lista y arranca el juego
L 0x4291 lee_joystick  Devuelve los ocho sentidos y el disparo del mando que se pida
L 0x42a3 lee_teclado_como_mando  Las flechas y el espacio, en el formato del joystick
L 0x42e7 lee_una_fila  Lee la fila E, la traduce, y le suma el disparo de la fila D
L 0x42fa traduce_direccion  Los cuatro bits de las flechas, a un sentido de ocho
L 0x431f lee_los_mandos  Deja en 0xE105 y 0xE135 lo que hacen los dos jugadores
L 0x435e lee_para_el_menu  Lo mismo, pero para moverse por las opciones
L 0x4373 mueve_el_cursor  Sube o baja la opcion elegida, y la resalta
L 0x43b7 pinta_el_cursor  Deja la flecha en la fila que toca
L 0x43db pinta_cuatro_listas  Borra la pantalla y pinta cuatro listas seguidas
L 0x43ea pinta_lista_de_tiles  Vuelca una lista de tiles en la tabla de nombres
L 0x441a borra_la_pantalla  Deja los 768 tiles de la tabla de nombres a cero
L 0x442d replica_vram  Copia de VRAM a VRAM byte a byte, y de paso replica los tercios
L 0x4456 manda_orden  Deja una orden en 0xE001 y no vuelve hasta que la interrupcion la hace
L 0x445f ejecuta_guion  El interprete de guiones: monta una pantalla entera
L 0x4475 guion_bytes_crudos  Comando 0: bytes al VDP, con repeticion
L 0x4496 guion_repite_byte  El 0x11 del comando 0: N veces el mismo byte
L 0x44ac guion_patrones  Comando 1: patrones pedidos por su numero
L 0x44d7 guion_relleno  Comando 3: una direccion y pares de cuenta y valor
L 0x44ea guion_patron_repetido  Cualquier otro comando: un patron, muchas veces
L 0x4505 pon_destino  Lee una direccion de VRAM de dos bytes y deja el VDP escribiendo ahi
L 0x450b escribe_tira  Suelta B tiles consecutivos y baja una fila
L 0x4524 borra_ram  Deja BC bytes a cero desde HL
L 0x452c esconde_sprites  Manda los 32 sprites fuera de la pantalla
L 0x4535 espera_confirmacion  Deja el rotulo parpadeando hasta que el jugador confirme
L 0x455e suma_a_hl  HL += A, que es como se indexa todo en este cartucho
L 0x4563 pon_escritura_con_reintento  SETWRT, y si la interrupcion se cuela, otra vez
L 0x457b pon_lectura  SETRD, con el mismo reintento
L 0x458c pon_escritura  SETWRT, con el mismo reintento
L 0x459d escribe_bloque_en  Coloca el puntero y suelta B bytes desde HL
L 0x45a0 escribe_bloque  Suelta B bytes desde HL, donde este el puntero
L 0x45ad escribe_bloque_simple  Como el anterior, con la version corta de SETWRT
L 0x45b2 rellena_en  Coloca el puntero y repite el byte C, B veces
L 0x45b6 rellena  Repite el byte A, B veces, donde este el puntero
L 0x45c3 rellena_desde  Coloca el puntero y repite el byte C, B veces
ecuta para montar la pista
D 0x4ff1 0x51fe tiles_de_la_pista  La tabla de nombres de la pista, en el formato de 0x43EA

# --- la pelota ---
D 0x550a 0x5512 datos_550a  Ocho bytes que lee 0x753B
F 0x550a 8
D 0x5512 0x5516 tabla_de_dificultad  Un valor por opcion de menu, que lee la interrupcion en 0x4065
F 0x5512 4
D 0x5516 0x5528 datos_5516  Dieciocho bytes que lee 0x5492
F 0x5516 18
D 0x5528 0x553c tabla_de_la_pelota  Cinco pares de punteros: la pelota crece con la altura
F 0x5528 4
D 0x553c 0x555d patrones_de_la_pelota  Los cinco tamanos, comprimidos para 0x5932

# --- las cuatro fichas de jugador ---
# 0x57BE reparte estos 164 bytes en cuatro copias de 41, en 0xE100, 0xE130,
# 0xE160 y 0xE190: son los cuatro jugadores del modo de dobles. Los bytes 0x10
# a 0x23 de cada ficha son los veinte de atributos de sprite -y, x, patron y
# color, por cada uno de los cinco- que 0x5920 vuelca al VDP.
D 0x57eb 0x588f fichas_de_los_jugadores  Cuatro fichas de 41 bytes, una por jugador
F 0x57eb 41

# --- las figuras del jugador ---
# Una figura son CINCO sprites de 16x16 apilados: 0x58A9 recorre cinco
# punteros (`ld b,005h`) descomprimiendo 32 bytes en cada vuelta, y 0x58D4
# salta esos diez bytes (`ld a,00ah`) para llegar al sexto, que apunta a las
# cinco parejas (y,x) con el sitio de cada uno. La compresion es la de 0x5932:
# 0x00 [n] son n bytes a cero, y el resto va tal cual.
D 0x5961 0x59d5 tabla_de_posturas  58 punteros a descripcion; los indices 26 a 31 estan a cero
F 0x5961 w
D 0x59d5 0x59e1 descripcion_59d5  Cinco punteros a patron y uno a las parejas (y,x)
F 0x59d5 w
D 0x59e1 0x59ed descripcion_59e1  Cinco punteros a patron y uno a las parejas (y,x)
F 0x59e1 w
D 0x59ed 0x59f9 descripcion_59ed  Cinco punteros a patron y uno a las parejas (y,x)
F 0x59ed w
D 0x59f9 0x5a05 descripcion_59f9  Cinco punteros a patron y uno a las parejas (y,x)
F 0x59f9 w
D 0x5a05 0x5a11 descripcion_5a05  Cinco punteros a patron y uno a las parejas (y,x)
F 0x5a05 w
D 0x5a11 0x5a1d descripcion_5a11  Cinco punteros a patron y uno a las parejas (y,x)
F 0x5a11 w
D 0x5a1d 0x5a29 descripcion_5a1d  Cinco punteros a patron y uno a las parejas (y,x)
F 0x5a1d w
D 0x5a29 0x5a35 descripcion_5a29  Cinco punteros a patron y uno a las parejas (y,x)
